# Copia a .env y reemplaza cada secreto antes de iniciar los servicios.
MARIADB_DATABASE=salvadiux_network
MARIADB_USER=salvadiux
MARIADB_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_SECRET
MARIADB_ROOT_PASSWORD=REPLACE_WITH_ANOTHER_LONG_RANDOM_SECRET
MARIADB_PORT=3306
REDIS_PASSWORD=REPLACE_WITH_A_DIFFERENT_LONG_RANDOM_SECRET
REDIS_PORT=6379
